{
  "expo": {
    "name": "Yuzu",
    "slug": "yuzu",
    "version": "1.0.0",
    "owner": "yuzula",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yuzu",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#fcf951"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.yuzu.ios"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#fcf951"
      },
      "package": "com.yuzu.android"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3c83602b-b346-4829-887e-b639a4fbe8c0"
      }
    }
  }
}
