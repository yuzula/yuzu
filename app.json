{
  "expo": {
    "name": "Yuzu",
    "slug": "yuzu",
    "version": "2.0.2",
    "owner": "yuzula",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yuzu",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#fcf951"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.yuzu.ios",
      "config": {
        "usesNonExemptEncryption": false
      },
      "buildNumber": "23"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#fcf951"
      },
      "package": "com.yuzu.android",
      "versionCode": 23
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3c83602b-b346-4829-887e-b639a4fbe8c0"
      }
    },
    "plugins": [
      "sentry-expo",
      "expo-tracking-transparency"
    ],
    "hooks": {
      "postPublish": [
        {
          "file": "sentry-expo/upload-sourcemaps",
          "config": {
            "organization": "yuzula",
            "project": "yuzu"
          }
        }
      ]
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/3c83602b-b346-4829-887e-b639a4fbe8c0"
    }
  }
}
