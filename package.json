{
  "name": "yuzu",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "android": "npx expo run:android",
    "android:device": "npx expo run:android --device",
    "build:all": "npx eas-cli build --platform all",
    "build:android": "npx eas-cli build --platform android",
    "build:ios": "npx eas-cli build --platform ios",
    "build:local:all": "npx eas-cli build --platform all --local",
    "build:local:android": "npx eas-cli build --platform android --local",
    "build:local:ios": "npx eas-cli build --platform ios --local",
    "build:preview:all": "npx eas-cli build --profile preview --platform all",
    "build:preview:android": "npx eas-cli build --profile preview --platform android",
    "build:preview:ios": "npx eas-cli build --profile preview --platform ios",
    "eject": "npx expo eject",
    "install:check": "npx expo install --check",
    "ios": "npx expo run:ios",
    "ios:device": "npx expo run:ios --device",
    "lint": "eslint --ext .js,.ts,.jsx,.tsx .",
    "lint:fix": "eslint --ext .js,.ts,.jsx,.tsx --fix .",
    "prebuild": "npx expo prebuild",
    "prebuild:clean": "npx expo prebuild --clean",
    "prepare": "husky",
    "start": "npx expo start --dev-client",
    "start:android": "npx expo start --android",
    "start:ios": "npx expo start --ios",
    "start:web": "npx expo start --web",
    "submit:android": "npx eas-cli submit --platform android",
    "submit:ios": "npx eas-cli submit --platform ios",
    "supa:gen:linked": "npx --yes supabase gen types typescript --linked --schema public",
    "supa:gen:local": "npx --yes supabase gen types typescript --local --schema public",
    "supa:reset": "npx supabase db reset --linked",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "jest": {
    "preset": "jest-expo"
  },
